# ============================================================
# PACK2EU – ENVIRONMENT VARIABLES (EXAMPLE)
# ============================================================
# Kopiere diese Datei nach .env und fülle die echten Werte ein!
# .env wird NICHT in Git eingecheckt!

# Server
PORT=3000
APP_URL=http://localhost:3000

# Datenbank (SQLite)
DATABASE_URL=./pack2eu.db

# JWT (für Authentifizierung)
JWT_SECRET=dein-geheimes-jwt-secret-min-32-zeichen-lang

# ============================================================
# STRIPE
# ============================================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs (aus dem Stripe-Dashboard)
STRIPE_PRICE_S=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Starter (15€/Monat)
STRIPE_PRICE_M=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Bestseller (49€/Monat)
STRIPE_PRICE_L=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Enterprise (149€/Monat)

# ============================================================
# LAPPA-API (⭐ MORGEN EINTRAGEN!)
# ============================================================
LAPPA_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LAPPA_BASE_URL=https://api.lappa.io

# ============================================================
# OPTIONAL: SHOPIFY
# ============================================================
SHOPIFY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
