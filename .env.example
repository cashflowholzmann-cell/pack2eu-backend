# Pack2EU Backend - Umgebungsvariablen
#
# Kopiere diese Datei zu ".env" und trage echte Werte ein. ".env" selbst
# ist in .gitignore und darf NIE ins Repo committet werden (siehe
# Sicherheitshinweis: JWT_SECRET/STRIPE_SECRET_KEY waren bis 2026-08-30
# versehentlich in der Git-Historie - falls das die produktiv genutzten
# Werte sind, unbedingt neu generieren/rotieren).

# --- Server ---
PORT=3000
JWT_SECRET=                    # mind. 32 Zeichen, zufällig generiert
DB_PATH=                       # optional, sonst db/pack2eu.db
APP_URL=                       # Basis-URL des Frontends (Stripe-Redirects)
CORS_ORIGIN=                   # z. B. https://pack2eu.netlify.app

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Preis-IDs aus dem Stripe-Dashboard (nicht die Beträge selbst):
STRIPE_PRICE_S=
STRIPE_PRICE_M=
STRIPE_PRICE_L=
STRIPE_PRICE_S_ANNUAL=
STRIPE_PRICE_M_ANNUAL=
STRIPE_PRICE_L_ANNUAL=
STRIPE_PRICE_AMAZON_ADDON=

# --- KI-Support-Chat ---
ANTHROPIC_API_KEY=
SUPPORT_EMAIL=                 # z. B. support@pack2eu.com
FEEDBACK_WEBHOOK_URL=          # optional, z. B. Slack-Webhook

# --- Marktplatz-Integrationen ---
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=
ETSY_CLIENT_ID=
ETSY_REDIRECT_URI=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_APP_ID=
AMAZON_REDIRECT_URI=
AMAZON_MARKETPLACE_IDS=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_MARKETPLACE_ID=

# --- Bevollmächtigte / Lappa ---
LAPPA_API_KEY=
LAPPA_BASE_URL=

# --- Test-Zugang (siehe routes/auth.js) ---
TEST_ACCESS_EMAILS=            # kommagetrennt, nur eigene Test-Accounts

# --- E-Mail-Versand (SMTP, beliebiger Anbieter) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                     # z. B. "Pack2EU <no-reply@pack2eu.com>"

# --- Internes Vertriebs-/Marketing-Tool (admin.html, siehe routes/admin.js) ---
ADMIN_PASSWORD=                # frei wählbares Passwort für den internen Zugang
